#!/bin/sh
command_name=${1:-}
case "$command_name" in
  check)
    shift
    installed_checker=/usr/lib/chatgpt-bin/updater/check_update.py
    if [ -f "$installed_checker" ]; then
      exec /usr/bin/python "$installed_checker" "$@"
    fi
    script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd) || exit 1
    exec /usr/bin/python "$script_dir/check_update.py" "$@"
    ;;
  status|build|install)
    installed_updater=/usr/lib/chatgpt-bin/updater/build_update.py
    if [ -f "$installed_updater" ]; then
      exec /usr/bin/python "$installed_updater" "$@"
    fi
    script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd) || exit 1
    exec /usr/bin/python "$script_dir/build_update.py" "$@"
    ;;
  *)
    printf '%s\n' 'Usage: chatgpt-bin-update {check|status|build|install} [arguments...]' >&2
    exit 2
    ;;
esac
